Checks: "-*,
  clang-diagnostic-*,
  clang-analyzer-*,
  cppcoreguidelines-init-variables,
  google-runtime-int,
  google-readability-avoid-underscore-in-googletest-name,
  misc-*,
  -misc-include-cleaner,
  performance-*,
  portability-*,
  readability-*,
  -misc-no-recursion,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers,
  -portability-avoid-pragma-once,
  -readability-use-concise-preprocessor-directives"
# The last two checks are clang-tidy 21 additions and are style only: #pragma once
# is the convention throughout this app and the Ledger SDK, and the #if defined()
# spellings they flag are inherited from upstream and correct.
WarningsAsErrors: "*"
CheckOptions:
  - key: readability-identifier-length.MinimumVariableNameLength
    value: 1
  - key: readability-identifier-length.MinimumParameterNameLength
    value: 1
  - key: readability-identifier-length.MinimumLoopCounterNameLength
    value: 1
  - key: readability-magic-numbers.IgnorePowersOf2IntegerValues
    value: true
